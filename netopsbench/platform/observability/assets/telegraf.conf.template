[global_tags]
  topology_id = "{{TOPOLOGY_ID}}"

[agent]
  interval = "10s"
  round_interval = true
  metric_batch_size = 5000
  metric_buffer_limit = 200000
  collection_jitter = "0s"
  flush_interval = "5s"
  flush_jitter = "1s"
  precision = ""
  debug = false

# --- OUTPUTS ---
[[outputs.influxdb_v2]]
  urls = ["{{INFLUXDB_URL}}"]
  token = "{{INFLUXDB_TOKEN}}"
  organization = "{{INFLUXDB_ORG}}"
  bucket = "{{INFLUXDB_BUCKET}}"
  content_encoding = "gzip"

# --- INPUTS ---

# 1. Syslog (UDP 514)
[[inputs.syslog]]
  server = "udp://:514"


# Map management IPs to hostnames and normalize source in one O(1) pass.
[[processors.starlark]]
  source = '''
ip_to_device = {{IP_MAPPINGS}}
mapping_keys = ["source", "agent_host", "agent_ip", "agent", "agent_address", "address", "target"]

def apply(metric):
    for key in mapping_keys:
        if key in metric.tags and metric.tags[key] in ip_to_device:
            metric.tags[key] = ip_to_device[metric.tags[key]]
    if "source" not in metric.tags:
        if "agent_host" in metric.tags:
            metric.tags["source"] = metric.tags["agent_host"]
        elif "agent_ip" in metric.tags:
            metric.tags["source"] = metric.tags["agent_ip"]
    return metric
'''


# Syslog filtering using Starlark
[[processors.starlark]]
  namepass = ["syslog"]
  source = '''
def apply(metric):
    msg = str(metric.fields.get("message", ""))
    # Filter out debug logs and other noise
    if "debug|" in msg or "pam_unix" in msg:
        return None
    return metric
'''

# Syslog Structure Parser
[[processors.regex]]
  namepass = ["syslog"]

  # BGP Down
  [[processors.regex.fields]]
    key = "message"
    pattern = ".*Peer .* moved from higher state ESTABLISHED to lower state.*"
    replacement = "BGP_DOWN"
    result_key = "event_category"

  # BGP Up
  [[processors.regex.fields]]
    key = "message"
    pattern = ".*Peer .* moved from .* to .* state ESTABLISHED.*"
    replacement = "BGP_UP"
    result_key = "event_category"

  # Link Down/Up (Generic)
  [[processors.regex.fields]]
    key = "message"
    pattern = ".*interface .* (down|up).*"
    replacement = "LINK_STATE"
    result_key = "event_category"

  # Config Change
  [[processors.regex.fields]]
    key = "message"
    pattern = ".*configuration changed.*"
    replacement = "CONFIG_CHANGE"
    result_key = "event_category"

  # Extract Interface Name (for Link events)
  [[processors.regex.fields]]
    key = "message"
    pattern = ".*interface ([a-zA-Z0-9/-]+) .*"
    replacement = "${1}"
    result_key = "interface"

  # Extract BGP Peer IP
  [[processors.regex.fields]]
    key = "message"
    pattern = ".*Peer ([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+).*"
    replacement = "${1}"
    result_key = "bgp_peer"

# 4. gNMI - Interface Counters - DYNAMIC
{{GNMI_INPUTS}}

[[processors.regex]]
  namepass = ["interfaces"]

  [[processors.regex.tags]]
    key = "path"
    pattern = "^/?COUNTERS/(Ethernet[0-9]+).*$"
    replacement = "${1}"
    result_key = "name"

[[processors.rename]]
  namepass = ["interfaces"]

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_IN_OCTETS"
    dest = "in_octets"

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_OUT_OCTETS"
    dest = "out_octets"

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_IN_UCAST_PKTS"
    dest = "in_unicast_pkts"

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_OUT_UCAST_PKTS"
    dest = "out_unicast_pkts"

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_IN_DISCARDS"
    dest = "in_discarded_packets"

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_OUT_DISCARDS"
    dest = "out_discarded_packets"

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_IN_ERRORS"
    dest = "in_errors"

  [[processors.rename.replace]]
    field = "SAI_PORT_STAT_IF_OUT_ERRORS"
    dest = "out_errors"

# Relay each topology's Pingmesh writes through its Telegraf worker so the
# shared InfluxDB receives bounded, compressed batches instead of one HTTP
# stream per client.
[[inputs.influxdb_v2_listener]]
  service_address = ":8186"
  max_undelivered_metrics = 200000
  read_timeout = "10s"
  write_timeout = "10s"
  token = "{{INFLUXDB_TOKEN}}"
  parser_type = "upstream"

# BGP neighbor snapshots collected by the worker host-side poller
[[inputs.tail]]
  files = ["/var/lib/netopsbench/bgp_neighbors*.lp"]
  from_beginning = true
  watch_method = "poll"
  max_undelivered_lines = 10000
  data_format = "influx"
